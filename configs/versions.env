# Cerium Centralized Toolchain & Dependency Pins
# All pinned revisions, hashes, and toolchain defaults live here.

# CERIUM_GN_REVISION: Set to override GN CIPD revision. If unset, dynamically resolves from src/DEPS.
CERIUM_GN_REVISION=""
CERIUM_DEPOT_TOOLS_REPO="https://chromium.googlesource.com/chromium/tools/depot_tools.git"
CERIUM_DEPOT_TOOLS_BRANCH="main"

CERIUM_NATIVELINK_HOST="127.0.0.1"
CERIUM_NATIVELINK_PORT="50051"
CERIUM_SISO_PROJECT="rbe-chromium-untrusted"
CERIUM_SISO_INSTANCE="projects/rbe-chromium-untrusted/instances/main"
CERIUM_BUILD_TIMEOUT_DEFAULT="9600"
